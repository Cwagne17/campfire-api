{
  "name": "campfire-api",
  "version": "1.0.0",
  "description": "A professional demo TypeScript Express REST API for campfires.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "openapi:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "aws-jwt-verify": "^5.1.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mongoose": "^8.13.2",
    "pino": "^9.6.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.0.0",
    "zod-openapi": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.1"
  }
}
